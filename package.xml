<?xml version="1.0"?>
<package format="3">
  <name>boson_camera</name>
  <version>0.0.1</version>
  <description>ROS2 wrapper for the FLIR Boson 640 thermal camera.</description>

  <maintainer email="shenbax@seas.upenn.edu">Shenbagaraj Kannapiran</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>camera_info_manager</depend>

  <build_depend>cv_bridge</build_depend>
  <exec_depend>cv_bridge</exec_depend>
  <depend>opencv</depend>
  <build_depend>ament_cmake_auto</build_depend>
  <exec_depend>ament_cmake_auto</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
